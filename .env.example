# Copy to .env and adjust. Every value has a working default for a local run;
# only ALLOWED_ORIGINS is required in production (docker-compose.prod.yml).

# Comma-separated list of origins allowed to call the API with cookies.
# Production: the public URL the app is served from, e.g. https://world.example.com
ALLOWED_ORIGINS=http://localhost:5555,http://127.0.0.1:5555,http://localhost:5173,http://127.0.0.1:5173

# Send the session cookie only over HTTPS. Set to false only for plain-http
# local runs; the server refuses to start with false when NODE_ENV=production.
COOKIE_SECURE=true

# Optional: session lifetime in seconds (default 30 days).
# SESSION_TTL_SECONDS=2592000

# Optional, dev only: proxy non-API requests to the Vite dev server
# (docker-compose.dev.yml sets this for the containerised backend).
# DEV_FRONTEND_PROXY_URL=http://host.docker.internal:5173
