      "css": ":host{--bg:#121214;--card-soft:#1e1e22;--card-strong:#1a1a1d;--control:#34343d;--control-hover:#41414c;--border:#48484f;--text:#f5f5f7;--muted:#a1a1ad;--muted-soft:#6d6d78;--accent:#ff5e8a;--danger:#ff5a7f;--success:#6fe1b0;--warning:#f5a623;--ring:color-mix(in srgb,var(--accent) 38%,transparent);font-family:Manrope,system-ui,sans-serif;color:var(--text)} .ds-chips{display:flex;gap:8px}.ds-chip{font:400 12.5px Manrope,system-ui,sans-serif;line-height:1;border:0;border-radius:9999px;padding:4px 12px;min-height:32px;color:var(--muted);background:var(--control);cursor:pointer;transition:color .15s ease,background .15s ease}.ds-chip:hover{color:var(--text);background:var(--control-hover)}.ds-chip.ds-on{color:var(--bg);background:var(--accent);font-weight:600}.ds-chip:focus-visible{outline:none;box-shadow:0 0 0 2px var(--ring)}"
