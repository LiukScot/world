      "description": "Neutral pill for secondary actions.",
      "html": "<button class=\"ds-btn\">Cancel</button>",
      "css": ":host{--bg:#121214;--card-soft:#1e1e22;--card-strong:#1a1a1d;--control:#34343d;--control-hover:#41414c;--border:#48484f;--text:#f5f5f7;--muted:#a1a1ad;--muted-soft:#6d6d78;--accent:#ff5e8a;--danger:#ff5a7f;--success:#6fe1b0;--warning:#f5a623;--ring:color-mix(in srgb,var(--accent) 38%,transparent);font-family:Manrope,system-ui,sans-serif;color:var(--text)} .ds-btn{font:600 14px Manrope,system-ui,sans-serif;border:0;border-radius:9999px;padding:12px 20px;min-height:40px;color:var(--text);background:var(--card-soft);cursor:pointer;transition:background .15s ease,color .15s ease}.ds-btn:hover{background:color-mix(in srgb,var(--text) 4%,var(--card-soft))}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px var(--ring)}"
    },
