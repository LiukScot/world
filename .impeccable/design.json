      "refersTo": "input",
      "description": "Uppercase label above a borderless tinted field.",
      "html": "<label class=\"ds-field\"><span>Notes</span><input placeholder=\"What happened today?\"></label>",
      "css": ":host{--bg:#121214;--card-soft:#1e1e22;--card-strong:#1a1a1d;--control:#34343d;--control-hover:#41414c;--border:#48484f;--text:#f5f5f7;--muted:#a1a1ad;--muted-soft:#6d6d78;--accent:#ff5e8a;--danger:#ff5a7f;--success:#6fe1b0;--warning:#f5a623;--ring:color-mix(in srgb,var(--accent) 38%,transparent);font-family:Manrope,system-ui,sans-serif;color:var(--text)} .ds-field{display:grid;gap:8px}.ds-field span{font:700 12px Manrope,system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}.ds-field input{font:500 13px Manrope,system-ui,sans-serif;color:var(--text);background:var(--control);border:0;border-radius:10px;padding:8px 12px;outline:none;transition:background .15s ease,box-shadow .15s ease}.ds-field input::placeholder{color:var(--muted-soft)}.ds-field input:hover,.ds-field input:focus{background:var(--control-hover)}.ds-field input:focus{box-shadow:inset 0 0 0 1px var(--accent)}"
    },
    {
